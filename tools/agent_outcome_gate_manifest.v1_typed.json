{
  "schema_id": "memory-fabric.agent-outcome-gate.v1",
  "manifest_version": 1,
  "checks": [
    {
      "id": "scripted_contracts",
      "required_for_scripted_qualification": true,
      "command": ["python", "-m", "unittest", "tests.test_agent_outcomes_contracts_typed", "tests.test_agent_outcome_gate_typed", "tests.test_action_fence_typed", "tests.test_stability", "tests.test_suite_hygiene"]
    },
    {
      "id": "lint",
      "required_for_scripted_qualification": true,
      "command": ["python", "-m", "ruff", "check", "src/memory_fabric/outcome_typed", "benchmarks/outcome_report.py", "benchmarks/outcome_recovery.py", "examples/outcome_recovery_demo.py", "tools/agent_outcome_gate.py", "tests/test_agent_outcomes_contracts.py", "tests/test_agent_outcome_gate.py"]
    },
    {
      "id": "types",
      "required_for_scripted_qualification": true,
      "command": ["python", "-m", "mypy", "src/memory_fabric/outcome_typed", "benchmarks/outcome_report.py", "benchmarks/outcome_recovery.py", "examples/outcome_recovery_demo.py", "tools/agent_outcome_gate.py"]
    },
    {
      "id": "full_repository",
      "required_for_scripted_qualification": true,
      "command": ["python", "-m", "unittest", "discover", "-s", "tests", "-t", "."]
    },
    {
      "id": "local_model",
      "required_for_scripted_qualification": false,
      "evidence_level": "local_model_tested",
      "command": null
    },
    {
      "id": "deployment_review",
      "required_for_scripted_qualification": false,
      "evidence_level": "deployment_validated",
      "command": null
    }
  ]
}
